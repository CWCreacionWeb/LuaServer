# ===== binarios pesados (se descargan con bootstrap.ps1) =====
/bin/
/downloads/

# ===== runtime =====
/data/
/logs/
/tmp/

# ===== generado automaticamente =====
/config/apache/vhosts/*.conf
/config/apache/ssl.conf
/config/https.on
/config/mailpit.on
/config/mariadb.on
/config/postgres.on
/config/postgres_root.pass
/config/mongodb.on
/config/terminal.on
/config/lanexpose.on
/config/lan-ip.txt
/config/mysql_root.pass
/config/ftp/
/config/php/extra-extensions.json

# ===== registro de proyectos: estado de cada maquina (plantilla: sites.example.json) =====
/config/sites.json

# ===== comandos personalizados guardados en el runner (Ejecutar en <proyecto>) =====
/config/run-presets.json

# ===== proyectos: NO versionar (cada proyecto es tuyo / tiene su propio repo) =====
/www/*
!/www/.gitkeep

# ===== phpMyAdmin: app de terceros + tema propio, no se versiona (ver CLAUDE.md) =====
/tools/phpmyadmin/

# varios
*.log
Thumbs.db
Desktop.ini

# basura de shell de Windows
tools/dashboard/%SystemDrive%/
**/cversions*.db
